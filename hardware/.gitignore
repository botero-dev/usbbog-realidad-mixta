# Build byproducts — regenerate with `make -C hardware ...` (see README.md).
car.net
car.xml
car.csv
car.png
erc.rpt
svg/

# KiCad's own local-history store (a git repo inside the project).
.history/

# KiCad per-user UI state (window positions, last-used layers...).
*.kicad_prl

# KiCad's project lock file. Left behind by a GUI session, and regenerated as
# needed — it encodes no design information, so it must not be committed.
*.lck
